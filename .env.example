# Copy to .env (git-ignored) and fill in. Never commit real keys.
APP_ENV=sandbox
HTTP_ADDR=:8080
DATABASE_PATH=bills.db

# Who takes the customer's bank transfer: monnify (default) or kora. Only that one's keys are needed.
PAYMENT_PROVIDER=monnify

# Kora. The test and live secret keys are told apart by the key itself, so the base URL stays the same.
# Set the webhook URL in the Kora dashboard to https://<your host>/webhooks/kora.
# Kora needs "bank transfer via API" switched on for your account (email support@korapay.com).
KORA_BASE_URL=https://api.korapay.com/merchant
KORA_SECRET_KEY=

MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=

ABS_BASE_URL=https://absvendor.com
ABS_API_KEY=
ABS_WEBHOOK_SECRET=
# Keep true until you deliberately want to spend real wallet money.
ABS_SANDBOX=true
# Optional. Leave ZEPTOMAIL_TOKEN and MAIL_FROM_EMAIL blank to disable the purchase-successful email entirely.
# The base URL depends on the ZeptoMail account's data centre.
MAIL_BASE_URL=https://cpaas.zoho.com
# The "send mail token" from the ZeptoMail mail agent (pasting it with its "Zoho-enczapikey " prefix is fine).
ZEPTOMAIL_TOKEN=
# Must belong to a domain verified in ZeptoMail.
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Mi MDev
# Only if ZeptoMail asks for one.
MAIL_BOUNCE_ADDRESS=
# ZeptoMail has no sandbox, so this one is ours: true means receipts are only logged, never sent.
# Set to false to actually deliver mail.
MAIL_SANDBOX=true

# Smallest payment, in naira, below which airtime is refused and data plans are hidden. Kora's own ₦100
# minimum is applied automatically when PAYMENT_PROVIDER=kora; set this only to raise it. 0 means none.
MIN_PAYMENT_NAIRA=0

# Protects /admin, and the direct /abs, /monnify, /kora and /email test endpoints, which are only served
# while APP_ENV=sandbox and ABS_SANDBOX=true. Required in production or when ABS_SANDBOX=false.
# Send it as "Authorization: Bearer <token>". Pick a long random value.
ADMIN_TOKEN=

# Pricing. What ABS charges is marked up by these percentages before customers see it. Every one must be
# at least 2%, or plans sell at a loss after the payment provider's fee of about 1.6%; the server refuses to
# start otherwise. The defaults below are the agreed numbers, so you only need to set what you want to change.
#MARKUP_MTN_PERCENT=2.5           # MTN plans under MARKUP_LARGE_FROM_NAIRA
#MARKUP_MTN_LARGE_PERCENT=2.2     # MTN plans from MARKUP_LARGE_FROM_NAIRA up (keeps them at the official price)
#MARKUP_LARGE_FROM_NAIRA=20000
#MARKUP_AIRTEL_PERCENT=4
#MARKUP_GLO_PERCENT=5
#MARKUP_9MOBILE_PERCENT=5
#MARKUP_DEFAULT_PERCENT=4         # any network not named above
# Data plan ids that are not offered at all (comma separated; setting it replaces the built-in list, empty hides nothing).
#HIDDEN_PLANS=5GGUX,PPVK8,P77ZY,PKTS6,PD5ZP,2PV3Y
# Service fee added to electricity: the greater of the minimum and the percentage, in whole naira, no cap. Airtime has none.
#ELECTRICITY_FEE_PERCENT=1.8
#ELECTRICITY_FEE_MIN_NAIRA=50
# Log a warning when the payment provider's fee on a payment is above this percent of it (0 turns it off).
#PAYMENT_FEE_WARN_PERCENT=1.7

# Alerts. The server emails this address when something needs a person: a refund is due (an order failed after the
# customer paid), an order's outcome is unknown, the ABS wallet ran out of money, or the payment fee is above
# PAYMENT_FEE_WARN_PERCENT. Needs the email settings above; with MAIL_SANDBOX=true the alerts are only logged.
#ADMIN_ALERT_EMAIL=you@example.com
# Also warn when the ABS wallet falls below this many naira, checked every ABS_BALANCE_CHECK_MINUTES. 0 turns the check off.
#ABS_LOW_BALANCE_NAIRA=5000
#ABS_BALANCE_CHECK_MINUTES=15

# Most of the settings above (the markups, hidden plans, the electricity fee, the fee warning limit, the alert address,
# the low-wallet threshold and check interval, and MAIL_SANDBOX) can also be changed while the server runs with
# PUT /admin/settings/{key}; the value set there wins over this file until you DELETE it. See GET /admin/settings.
# Keys, secrets, ADMIN_TOKEN, PAYMENT_PROVIDER, ABS_SANDBOX and APP_ENV can only be set here.

# ---- Running on a server (see deploy/README.md) ----
# Set to true when Caddy or nginx sits in front, so the rate limits count each customer's own address.
# Leave it false when the server is reached directly (anyone could then forge the header).
#TRUST_PROXY=true
# Listen only on this machine when a proxy is in front, so nothing else can reach the server.
#HTTP_ADDR=127.0.0.1:8080
# The server saves a snapshot of the database here every BACKUP_EVERY_MINUTES and emails the alert address if it fails.
# Copy them off the server too (deploy/offsite-backup.sh). Without BACKUP_DIR there are no snapshots.
#BACKUP_DIR=/var/backups/bills
#BACKUP_EVERY_MINUTES=60
# Raw webhook bodies older than this are deleted (0 keeps them forever). Orders are never deleted.
#WEBHOOK_RETENTION_DAYS=90
