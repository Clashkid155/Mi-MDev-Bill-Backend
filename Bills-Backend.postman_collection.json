{
	"info": {
		"name": "Bills Backend",
		"description": "Test calls for the Mi MDev bills backend. Start the server with `go run .` (APP_ENV=sandbox). The app does not use ABS vouchers; the /abs/voucher request under \"ABS Vendor (direct)\" is only for testing ABS itself. The /abs, /monnify, /kora and /email folders call the providers directly and need the admin token when ADMIN_TOKEN is set; the server only serves them while APP_ENV=sandbox and ABS_SANDBOX=true. The /admin requests are always served and always need the token in production. Every response uses one envelope: {\"status\":\"successful\"|\"failed\",\"message\":\"...\",\"data\":{...},\"error\":\"...\"}. Look under `data` for the actual payload (order id, invoice reference, etc.); `error` is only present when status is \"failed\".",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		},
		{
			"key": "invoiceReference",
			"value": ""
		},
		{
			"key": "orderId",
			"value": ""
		},
		{
			"key": "transactionReference",
			"value": ""
		},
		{
			"key": "absOrderId",
			"value": ""
		},
		{
			"key": "adminToken",
			"value": ""
		},
		{
			"key": "koraReference",
			"value": ""
		},
		{
			"key": "koraSecretKey",
			"value": ""
		},
		{
			"key": "monnifyBaseUrl",
			"value": "https://sandbox.monnify.com"
		},
		{
			"key": "monnifyApiKey",
			"value": ""
		},
		{
			"key": "monnifySecretKey",
			"value": ""
		},
		{
			"key": "monnifyToken",
			"value": ""
		},
		{
			"key": "categoryCode",
			"value": "ELECTRICITY"
		},
		{
			"key": "billerCode",
			"value": ""
		},
		{
			"key": "productCode",
			"value": ""
		},
		{
			"key": "customerId",
			"value": ""
		},
		{
			"key": "billAmount",
			"value": "100"
		},
		{
			"key": "validationReference",
			"value": ""
		},
		{
			"key": "billsReference",
			"value": ""
		}
	],
	"item": [
		{
			"name": "Health",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/healthz",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"healthz"
					]
				}
			}
		},
		{
			"name": "ABS Vendor (direct)",
			"item": [
				{
					"name": "Catalog (start here)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/abs/catalog",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"catalog"
							]
						},
						"description": "ABS's live catalog: airtime providers, data plans, electricity services, voucher providers. Use it to find the ids the calls below need."
					}
				},
				{
					"name": "Buy airtime",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/abs/airtime",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"airtime"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"network\": \"MTNAIR6TFD\",\n  \"phone\": \"08012345678\",\n  \"amount_naira\": 100\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "network is an AIRTIME product trackid. Minimum 50 naira. The reply has sandbox:true unless ABS_SANDBOX=false."
					}
				},
				{
					"name": "Buy data",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/abs/data",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"data"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"network\": \"MTN56TFD\",\n  \"plan\": \"6BO1H\",\n  \"phone\": \"08012345678\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "network is a DATA network trackid (different from the airtime id) and plan is a plan trackid."
					}
				},
				{
					"name": "Buy electricity",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/abs/electricity",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"electricity"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"disco\": \"SERVICE_TRACKID\",\n  \"meter\": \"12345678901\",\n  \"amount_naira\": 1000\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Minimum 1000 naira. Run Validate meter first."
					}
				},
				{
					"name": "Buy airtime voucher",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/abs/voucher",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"voucher"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"network\": \"MTNAIR6TFD\",\n  \"unit\": \"HBSI2\",\n  \"quantity\": 1\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "quantity is 1-30."
					}
				},
				{
					"name": "Validate meter (free)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/abs/validate-meter",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"validate-meter"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"disco\": \"SERVICE_TRACKID\",\n  \"meter\": \"12345678901\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					}
				},
				{
					"name": "Check transaction",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/abs/transaction/{{absOrderId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"abs",
								"transaction",
								"{{absOrderId}}"
							]
						},
						"description": "Looks up an order ABS already accepted. Set absOrderId to the id ABS gave the order (the order_id in ABS webhooks)."
					}
				}
			],
			"description": "Calls ABS's Direct API through the backend. Purchases are only validated while ABS_SANDBOX=true."
		},
		{
			"name": "Email (direct)",
			"item": [
				{
					"name": "Send email",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/email/send",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"email",
								"send"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"to\": \"test@example.com\",\n  \"to_name\": \"Test User\",\n  \"subject\": \"Test email\",\n  \"text\": \"Hello from Mi MDev.\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Sends one email through ZeptoMail directly, bypassing the order flow. With MAIL_SANDBOX=true (the default) nothing is sent, the reply says so; set MAIL_SANDBOX=false to actually deliver."
					}
				}
			]
		},
		{
			"name": "Monnify (direct)",
			"item": [
				{
					"name": "Create invoice",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/monnify/invoice",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monnify",
								"invoice"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount_naira\": 100,\n  \"email\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Optional: name, description, reference, expires_in_minutes (default 30)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const r = pm.response.json();",
									"if (r.data && r.data.reference) pm.collectionVariables.set('invoiceReference', r.data.reference);"
								]
							}
						}
					]
				},
				{
					"name": "Get invoice",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/monnify/invoice/{{invoiceReference}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monnify",
								"invoice",
								"{{invoiceReference}}"
							]
						},
						"description": "Uses the reference saved by Create invoice."
					}
				},
				{
					"name": "Verify transaction (what was really paid)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/monnify/transaction/{{transactionReference}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monnify",
								"transaction",
								"{{transactionReference}}"
							]
						},
						"description": "Asks Monnify about the payment itself: payment_status (PAID, PARTIALLY_PAID, OVERPAID, PENDING...) and amount_paid_naira vs total_payable_naira. Use the transaction_reference from Create invoice."
					}
				},
				{
					"name": "Cancel invoice",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/monnify/invoice/{{invoiceReference}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"monnify",
								"invoice",
								"{{invoiceReference}}"
							]
						}
					}
				}
			]
		},
		{
			"name": "Kora (direct)",
			"item": [
				{
					"name": "Create charge",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/kora/charge",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"kora",
								"charge"
							]
						},
						"description": "Needs PAYMENT_PROVIDER=kora and a Kora test secret key. Asks Kora for a one-time bank account. Optional: name, reference (at least 8 characters). In test mode Kora pays it for you after about 2 minutes. This is also the first call to run: it settles the endpoint path, which Kora's text guide does not print.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"amount_naira\": 100,\n  \"email\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const r = pm.response.json();",
									"if (r.data && r.data.reference) pm.collectionVariables.set('koraReference', r.data.reference);"
								]
							}
						}
					]
				},
				{
					"name": "Get charge",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/kora/charge/{{koraReference}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"kora",
								"charge",
								"{{koraReference}}"
							]
						},
						"description": "Kora's Transaction Query. status is PAID, PENDING or FAILED; amount_accepted_naira is the amount we may give value for (Kora's amount_accepted)."
					}
				}
			]
		},
		{
			"name": "Monnify Bills (direct to Monnify)",
			"description": "Walks Monnify Bills Payment step by step, calling Monnify itself rather than this backend, to learn how the API behaves before anything is built. Run 1 to 4 to browse, 5 to validate, 6 to vend, 7 to requery.",
			"item": [
				{
					"name": "1. Login",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/auth/login",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Calls Monnify directly (not this backend). Fill monnifyApiKey and monnifySecretKey in the collection variables; monnifyBaseUrl defaults to the sandbox. Saves the access token for the other requests. Never commit or share a collection with real keys filled in.",
						"auth": {
							"type": "basic",
							"basic": [
								{
									"key": "username",
									"value": "{{monnifyApiKey}}",
									"type": "string"
								},
								{
									"key": "password",
									"value": "{{monnifySecretKey}}",
									"type": "string"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const t = (pm.response.json().responseBody || {}).accessToken;",
									"if (t) pm.collectionVariables.set('monnifyToken', t);"
								]
							}
						}
					]
				},
				{
					"name": "2. Biller categories",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/biller-categories?size=50",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"biller-categories"
							],
							"query": [
								{
									"key": "size",
									"value": "50"
								}
							]
						},
						"description": "Read only. AIRTIME, DATA_BUNDLE, DATA, ELECTRICITY, CABLE_TV, BETTING, EDUCATION and TRANSPORTATION were returned for the first account tested."
					}
				},
				{
					"name": "3. Billers in a category",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/billers?category_code={{categoryCode}}&size=50",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"billers"
							],
							"query": [
								{
									"key": "category_code",
									"value": "{{categoryCode}}"
								},
								{
									"key": "size",
									"value": "50"
								}
							]
						},
						"description": "Read only. Set categoryCode first (for example ELECTRICITY, AIRTIME, DATA_BUNDLE or DATA). Saves the first biller code as billerCode; change it to pick another."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const b = (pm.response.json().responseBody || {}); const list = b.content || [];",
									"if (list.length) pm.collectionVariables.set('billerCode', list[0].code);"
								]
							}
						}
					]
				},
				{
					"name": "4. Products of a biller",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/biller-products?biller_code={{billerCode}}&size=50",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"biller-products"
							],
							"query": [
								{
									"key": "biller_code",
									"value": "{{billerCode}}"
								},
								{
									"key": "size",
									"value": "50"
								}
							]
						},
						"description": "Read only. This is where a product's price, any fee and any commission would show; look at every field of the reply. Saves the first product as productCode (field name is read as code, or productCode)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const b = (pm.response.json().responseBody || {}); const list = b.content || [];",
									"if (list.length) pm.collectionVariables.set('productCode', list[0].code || list[0].productCode);"
								]
							}
						}
					]
				},
				{
					"name": "5. Validate customer",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/validate-customer",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"validate-customer"
							]
						},
						"description": "Read only. Checks a meter, phone or smart card number. If vendInstruction.requireValidationRef is true the vend needs the validationReference, which this request saves.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productCode\": \"{{productCode}}\",\n  \"customerId\": \"{{customerId}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const b = (pm.response.json().responseBody || {});",
									"const v = (b.vendInstruction || {}).validationReference || b.validationReference;",
									"pm.collectionVariables.set('validationReference', v || '');"
								]
							}
						}
					]
				},
				{
					"name": "6. Vend (spends wallet money)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/vend",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"vend"
							]
						},
						"description": "SANDBOX ONLY unless you mean it: on a live account this debits your Monnify wallet. A fresh unique reference is generated for each send and saved as billsReference. validationReference is sent only if the validate step produced one. Set billAmount and customerId first.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"productCode\": \"{{productCode}}\",\n  \"customerId\": \"{{customerId}}\",\n  \"amount\": {{billAmount}},\n  \"reference\": \"{{billsReference}}\",\n  \"validationReference\": \"{{validationReference}}\",\n  \"emailAddress\": \"test@example.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('billsReference', 'MDEVTEST_' + Date.now());"
								]
							}
						}
					]
				},
				{
					"name": "7. Requery a vend",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{monnifyToken}}"
							}
						],
						"url": {
							"raw": "{{monnifyBaseUrl}}/api/v1/vas/bills-payment/requery?reference={{billsReference}}",
							"host": [
								"{{monnifyBaseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"vas",
								"bills-payment",
								"requery"
							],
							"query": [
								{
									"key": "reference",
									"value": "{{billsReference}}"
								}
							]
						},
						"description": "Read only. Status is IN_PROGRESS, SUCCESS or FAILED. Run it after Vend, or any time the vend reply was unclear."
					}
				}
			]
		},
