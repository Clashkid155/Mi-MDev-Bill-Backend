		{
			"name": "Webhooks (simulated)",
			"item": [
				{
					"name": "Monnify: successful payment (simulated)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/webhooks/monnify",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhooks",
								"monnify"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"eventType\": \"SUCCESSFUL_TRANSACTION\",\n  \"eventData\": {\n    \"transactionReference\": \"{{transactionReference}}\",\n    \"paymentStatus\": \"PAID\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Sandbox only: signatures are not checked outside production. Set transactionReference to the one returned by Create order. The backend still asks Monnify whether the invoice is really PAID, so an unpaid invoice will not vend."
					}
				},
				{
					"name": "Kora: successful payment (simulated)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/webhooks/kora",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhooks",
								"kora"
							]
						},
						"description": "Kora webhooks are always signature checked. The pre-request script signs the data object with the koraSecretKey variable (HMAC SHA256, hex) and sets x-korapay-signature. Set orderId to the id from Create order. The backend still asks Kora what was really paid, so an unpaid order will not vend.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"charge.success\",\n  \"data\": {\n    \"reference\": \"{{orderId}}\",\n    \"payment_reference\": \"{{orderId}}\",\n    \"currency\": \"NGN\",\n    \"amount\": 100,\n    \"fee\": 1.5,\n    \"status\": \"success\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const body = JSON.parse(pm.request.body.raw);",
									"const sig = CryptoJS.HmacSHA256(JSON.stringify(body.data), pm.collectionVariables.get('koraSecretKey')).toString();",
									"pm.request.headers.upsert({key: 'x-korapay-signature', value: sig});"
								]
							}
						}
					]
				},
				{
					"name": "ABS: transaction settled (simulated)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/webhooks/abs",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"webhooks",
								"abs"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"transaction.settled\",\n  \"data\": {\n    \"order_id\": \"BD1\",\n    \"status\": \"1\",\n    \"amount\": \"100.00\",\n    \"recipient\": \"08012345678\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Only works unsigned when ABS_WEBHOOK_SECRET is empty. Events are just logged for now."
					}
				}
			]
		}
