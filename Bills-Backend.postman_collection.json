					"name": "Catalog (via orders API)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/v1/catalog",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"v1",
								"catalog"
							]
						},
						"description": "Prices here are what customers pay: ABS's price marked up per network (MTN 2.5%, 2.2% from \u20a620,000; Airtel 4%; Glo 5%), rounded up to \u20a65. Plans ABS runs as promotions (names with HOT DEAL, CHEAP OFFER or BEST DEAL) are in their own \"Deals\" category, first in each network. A few plans are hidden on purpose. The reply also has electricity_fee {min_kobo, percent}: the service fee on electricity is the greater of the two, rounded up to whole naira, so the app can show the total before ordering. The vendor cost is never in this reply."
					}
				},
